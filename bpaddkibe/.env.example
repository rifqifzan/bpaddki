# ==========================================================
# Aplikasi
# ==========================================================
NODE_ENV=development
PORT=3300
APP_NAME=Sistem Informasi Kendaraan Dinas Operasional
API_PREFIX=api/v1

# ==========================================================
# Database PostgreSQL
# ==========================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kendaraan_dinas
DB_SSL=false
DB_POOL_MAX=10

# true: TypeORM membuat/menyelaraskan tabel otomatis (khusus development).
# Pada production gunakan false dan jalankan migration.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ==========================================================
# Keamanan
# ==========================================================
# Minimal 16 karakter. WAJIB diisi pada production.
API_KEY=dev-api-key-change-me
# Pisahkan dengan koma, contoh: http://localhost:5173,https://admin.example.go.id
CORS_ORIGINS=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ==========================================================
# Dokumentasi & seed
# ==========================================================
DOCS_ENABLED=true
DOCS_PATH=docs
# Seed referensi PD (DISDIK, DINKES, PUPR)
SEED_PD=true
# Seed data demo PNS/kendaraan/penugasan (otomatis nonaktif di production)
SEED_DEMO=true
